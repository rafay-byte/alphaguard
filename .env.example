# ==== Alpaca Paper Trading ====
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ==== Alpaca CLI Integration ====
# Set to true to route trade execution through Alpaca's official CLI binary
# Requires: `go install github.com/alpacahq/cli/cmd/alpaca@latest`
# Then run: `alpaca profile login --api-key` to authenticate
USE_ALPACA_CLI=true

# ==== Alpaca MCP Server ====
# The Market Analyst agent connects to Alpaca's official MCP server for
# live account context. Requires: `pip install alpaca-mcp-server` or `uvx`
# Set to true to enable MCP-powered account context in the Market Analyst agent
USE_ALPACA_MCP=true

# ==== AI Provider ====
# Supported: openai, anthropic, gemini  (leave AI_API_KEY blank to run in DEMO MODE)
AI_PROVIDER=openai
AI_API_KEY=

# ==== App ====
SECRET_KEY=change-me-super-secret
DATABASE_URL=sqlite:///alphaguard.db
APP_ENV=development
DEMO_MODE=true
